{
  "_version": "1.73.1",
  "sap.app": {
    "id": "attachmentservice",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "77e65744-6c5e-479c-977f-6e0291be7eba"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zzui_cchattach_o4/srvd/sap/zzui_cchattach_o4/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zch_attachment-list": {
          "semanticObject": "zch_attachment",
          "action": "list",
          "title": "{{zch_attachment-list.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.10",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      },
      "components": {
        "sap.se.mi.plm.lib.attachmentservice.attachment": {}
      }
    },
    "componentUsages": {
      "attachmentReuseComponent": {
        "name": "sap.se.mi.plm.lib.attachmentservice.attachment",
        "settings": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "attachmentservice.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AttachmentList",
          "target": "AttachmentList"
        },
        {
          "pattern": "Attachment({key}):?query:",
          "name": "AttachmentObjectPage",
          "target": "AttachmentObjectPage"
        }
      ],
      "targets": {
        "AttachmentList": {
          "type": "Component",
          "id": "AttachmentList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Attachment",
              "variantManagement": "Page",
              "navigation": {
                "Attachment": {
                  "detail": {
                    "route": "AttachmentObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "AttachmentObjectPage": {
          "type": "Component",
          "id": "AttachmentObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Attachment",
              "content": {
                "body": {
                  "sections": {
                    "customSectionReuse": {
                      "title": "{i18n>zch_attachment-list.flpTitle}",
                      "embeddedComponent": {
                        "name": "sap.se.mi.plm.lib.attachmentservice.attachment",
                        "settings": {
                          "mode": "{= ${ui>/isEditable}?'C':'D'}",
                          "objectType": "ZCHOBJ01",
                          "objectKey": "{=${IsActiveEntity}?${UUID}:${DraftAdministrativeData/DraftUUID}}",   
                          "attributeHandling": {
                            "_VisibleAttributes": {
                                "UPLOADEDBY": true,
                                "UPLOADEDON": true,
                                "FILESIZE": true,
                                "ENABLELINK": true,
                                "ATTACHMENTSTATUS": true,
                                "ATTACHMENTTITLE": true,
                                "SOURCE": true,
                                "DIRDETAILS": true
                            },
                            "_VisibleActions": {
                                "RENAME": true,
                                "DELETE": true,
                                "ADD": true,
                                "ADDURL": true,
                                "DOWNLOAD": true
                            }
                          }
                        }
                      },
                      "position": {
                        "placement": "After",
                        "anchor": "Sections"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "attachmentservice.ext.controller.ObjectPageExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
