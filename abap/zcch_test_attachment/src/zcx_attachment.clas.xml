CLASS zcx_attachment IMPLEMENTATION.


  METHOD constructor ##ADT_SUPPRESS_GENERATION.
    super->constructor( previous = previous ).
    mv_attr1 = attr1.
    mv_attr2 = attr2.
    mv_attr3 = attr3.
    mv_attr4 = attr4.
    if_t100_dyn_msg~msgv1 = msgv1.
    if_t100_dyn_msg~msgv2 = msgv2.
    if_t100_dyn_msg~msgv3 = msgv3.
    if_t100_dyn_msg~msgv4 = msgv4.
    if_t100_dyn_msg~msgty = severity.

    if_abap_behv_message~m_severity = severity.
    CLEAR me->textid.
    IF textid IS INITIAL.
      if_t100_message~t100key = if_t100_message=>default_textid.
    ELSE.
      if_t100_message~t100key-attr1 = COND #( WHEN msgv1 IS NOT INITIAL THEN 'IF_T100_DYN_MSG~MSGV1' ).
      if_t100_message~t100key-attr2 = COND #( WHEN msgv2 IS NOT INITIAL THEN 'IF_T100_DYN_MSG~MSGV2' ).
      if_t100_message~t100key-attr3 = COND #( WHEN msgv3 IS NOT INITIAL THEN 'IF_T100_DYN_MSG~MSGV3' ).
      if_t100_message~t100key-attr4 = COND #( WHEN msgv4 IS NOT INITIAL THEN 'IF_T100_DYN_MSG~MSGV4' ).
      if_t100_message~t100key-msgid = textid-msgid.
      if_t100_message~t100key-msgno = textid-msgno.
    ENDIF.
  ENDMETHOD.
ENDCLASS.
